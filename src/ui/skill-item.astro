---
import SkillStars from "./skill-stars.astro";

type Props = {
  href: string;
  slug: string;
  description?: string;
  ownerLabel?: string;
  avatarUrl?: string;
  hideTitle?: boolean;
  wrapDescription?: boolean;
  stars?: number;
  repository?: string;
};

const {
  href,
  slug,
  description,
  ownerLabel,
  avatarUrl,
  hideTitle,
  wrapDescription = false,
  stars,
  repository,
} = Astro.props as Props;
---

<a
  href={href}
  class="skills-item group border-line-default relative flex items-center gap-3 border-b pt-3 pb-4 hover:z-20"
>
  {
    avatarUrl ? (
      <img
        src={avatarUrl}
        alt={`${ownerLabel ?? slug} avatar`}
        width="40"
        height="40"
        loading="lazy"
        decoding="async"
        class="border-line-default size-10 shrink-0 rounded-xl border"
      />
    ) : null
  }
  <div class="skill-details flex min-w-0 flex-1 flex-col">
    <div class="skill-header flex items-center gap-2">
      {
        hideTitle ? null : (
          <span class="type-body-md text-content-primary truncate font-[450]">
            {slug}
          </span>
        )
      }
      {
        ownerLabel ? (
          <span class="type-body-md text-content-muted flex shrink-0 items-center gap-1 font-[450]">
            <svg
              aria-hidden="true"
              class="text-content-extra-muted size-3.5"
              viewBox="0 0 98 96"
              fill="currentColor"
            >
              <path d="M48.9 0C21.8 0 0 22.1 0 49.2c0 21.7 14 40.1 33.4 46.6 2.4.4 3.3-1 3.3-2.3v-8.2c-13.6 3-16.5-5.8-16.5-5.8-2.2-5.7-5.4-7.2-5.4-7.2-4.4-3 .3-3 .3-3 4.8.3 7.3 5 7.3 5 4.3 7.4 11.2 5.3 13.9 4 .4-3.1 1.7-5.3 3-6.5-10.9-1.2-22.4-5.5-22.4-24.3 0-5.4 1.9-9.8 5-13.3-.5-1.2-2.2-6.3.5-13.1 0 0 4.1-1.3 13.5 5.1 3.9-1.1 8.1-1.7 12.3-1.7 4.2 0 8.4.6 12.3 1.7 9.4-6.4 13.5-5.1 13.5-5.1 2.7 6.8 1 11.9.5 13.1 3.1 3.5 5 7.9 5 13.3 0 18.9-11.5 23.1-22.5 24.3 1.8 1.6 3.3 4.7 3.3 9.5v14.1c0 1.4.9 2.7 3.4 2.3C84 89.3 98 70.9 98 49.2 98 22.1 76 0 48.9 0Z" />
            </svg>
            {ownerLabel}
          </span>
        ) : null
      }
    </div>
    {
      description ? (
        <div
          class:list={[
            "skill-description type-body-md text-content-secondary",
            wrapDescription ? "break-words whitespace-normal" : "truncate",
          ]}
        >
          {description}
        </div>
      ) : null
    }
  </div>
  {
    stars != null && repository ? (
      <SkillStars stars={stars} repository={repository} column />
    ) : null
  }
</a>

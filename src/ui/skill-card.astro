---
type Props = {
  href: string;
  slug: string;
  description?: string;
  ownerLabel?: string;
  avatarUrl?: string;
  hideTitle?: boolean;
  ariaLabel?: string;
  variant?: "card" | "list";
  /** Allow list descriptions to wrap instead of truncating. */
  wrapDescription?: boolean;
};

import Card from "./card.astro";
import SkillItem from "./skill-item.astro";
import SkillStars from "./skill-stars.astro";
import {
  repositoryForSkillHref,
  starsForRepository,
} from "../lib/skill-repository";

const {
  href,
  slug,
  description,
  ownerLabel,
  avatarUrl,
  hideTitle,
  variant = "card",
  wrapDescription = false,
} = Astro.props as Props;
const repository = repositoryForSkillHref(href);
const stars = starsForRepository(repository);
---

{
  variant === "list" ? (
    <SkillItem
      href={href}
      slug={slug}
      description={description}
      ownerLabel={ownerLabel}
      avatarUrl={avatarUrl}
      hideTitle={hideTitle}
      wrapDescription={wrapDescription}
      stars={stars}
      repository={repository}
    />
  ) : (
    <a href={href} class="group relative block hover:z-20">
      <Card className="transition-colors group-hover:border-content-extra-muted">
        <div class="flex flex-col gap-3">
          {hideTitle ? null : (
            <div class="text-content-primary font-[450]">{slug}</div>
          )}
          {description ? (
            <div class="text-content-secondary line-clamp-3 text-[14px] leading-snug">
              {description}
            </div>
          ) : null}
          {(ownerLabel && avatarUrl) || (stars != null && repository) ? (
            <div class="mt-1 flex min-w-0 items-center gap-x-3">
              {ownerLabel && avatarUrl ? (
                <>
                  <img
                    src={avatarUrl}
                    alt={`${ownerLabel} avatar`}
                    width="20"
                    height="20"
                    loading="lazy"
                    class="border-line-default size-5 rounded-full border"
                  />
                  <span class="text-content-secondary text-[12px]">
                    {ownerLabel}
                  </span>
                </>
              ) : null}
              {stars != null && repository ? (
                <SkillStars stars={stars} repository={repository} />
              ) : null}
            </div>
          ) : null}
        </div>
      </Card>
    </a>
  )
}

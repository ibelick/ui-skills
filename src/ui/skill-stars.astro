---
import { formatStarCount } from "../lib/format-stars";

type Props = {
  stars: number;
  repository: string;
  href?: string;
};

const { stars, repository, href } = Astro.props as Props;
const formatted = formatStarCount(stars).replace(/\+$/, "");
const label = `${formatted} GitHub stars on ${repository}`;
const Tag = href ? "a" : "span";
---

<Tag
  href={href}
  target={href ? "_blank" : undefined}
  rel={href ? "noopener noreferrer" : undefined}
  class:list={[
    "type-body-md text-content-muted inline-flex shrink-0 items-center gap-1 font-[450] tabular-nums",
    href ? "hover:text-content-primary" : "",
  ]}
  aria-label={label}
  title={label}
>
  <svg
    aria-hidden="true"
    class="text-content-extra-muted size-3.5 shrink-0"
    viewBox="0 0 16 16"
    fill="currentColor"
  >
    <path
      d="M8 .7 9.9 5.2l4.9.4-3.8 3.2 1.2 4.8L8 11.2 3.8 13.6l1.2-4.8L1.2 5.6l4.9-.4L8 .7Z"
    ></path>
  </svg>
  <span aria-hidden="true">{formatted}</span>
</Tag>

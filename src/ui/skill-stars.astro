---
import { formatStarCount } from "../lib/format-stars";

type Props = {
  stars: number;
  repository: string;
  href?: string;
  /** Align counts so a list can be scanned as a column. */
  column?: boolean;
};

const { stars, repository, href, column = false } = Astro.props as Props;
const formatted = formatStarCount(stars);
const label = `${formatted} GitHub stars on ${repository}`;
const Tag = href ? "a" : "span";
---

<Tag
  href={href}
  target={href ? "_blank" : undefined}
  rel={href ? "noopener noreferrer" : undefined}
  class:list={[
    "skill-stars type-body-sm text-content-secondary relative inline-flex shrink-0 items-center gap-1 tabular-nums",
    href ? "hover:text-content-primary" : "",
  ]}
  aria-label={label}
  title={label}
>
  <span aria-hidden="true" class="text-[13px] leading-none">★</span>
  <span aria-hidden="true" class:list={[column ? "w-16 text-right" : ""]}>
    {formatted}
  </span>
</Tag>

---
import { CopyButton } from "./copy-button";
import {
  highlightCode,
  type CodeHighlightLanguage,
} from "../lib/code-highlighter";

type CodeBlockVariant = "inline" | "stacked" | "chip";

type Props = {
  code?: string;
  language?: CodeHighlightLanguage;
  lines?: Array<Array<{ text: string; className?: string }>>;
  copyContent?: string;
  variant?: CodeBlockVariant;
  align?: "start" | "center";
  truncate?: boolean;
  wrapOnMobile?: boolean;
  mobileSurface?: boolean;
  className?: string;
  id?: string;
};

const {
  code,
  language = "bash",
  lines = [],
  copyContent,
  variant = "inline",
  align: alignProp,
  truncate: truncateProp,
  wrapOnMobile: wrapOnMobileProp,
  mobileSurface: mobileSurfaceProp,
  className = "",
  id,
} = Astro.props as Props;

const isChip = variant === "chip";
const align =
  alignProp ?? (variant === "inline" || isChip ? "center" : "start");
const truncate = truncateProp ?? variant === "inline";
const wrapOnMobile = wrapOnMobileProp ?? variant === "stacked";
const mobileSurface = mobileSurfaceProp ?? variant === "stacked";

const highlightedHtml = code ? await highlightCode(code, language) : null;
const content =
  copyContent ??
  code ??
  lines.map((line) => line.map((segment) => segment.text).join("")).join("\n");
const alignClass = align === "center" ? "items-center" : "items-start";
const preClass = truncate
  ? "m-0 min-w-0 flex-1 overflow-hidden pr-3 type-code text-content-primary text-ellipsis whitespace-nowrap"
  : wrapOnMobile
    ? "m-0 min-w-0 flex-1 whitespace-pre-wrap break-words pr-3 type-code text-content-primary sm:whitespace-nowrap"
    : "m-0 min-w-0 flex-1 pr-3 type-code text-content-primary";
const shellClass = mobileSurface
  ? "relative flex justify-between rounded-[8px] border-none bg-surface-default py-3.5 pr-4 pl-6 shadow-2xs ring-1 ring-line-default"
  : "relative flex justify-between rounded-none border-t border-b border-line-default bg-surface-default py-3.5 pr-4 pl-6 shadow-2xs sm:rounded-[8px] sm:border-none sm:ring-1 sm:ring-line-default";
---

{
  isChip ? (
    <div
      id={id}
      class={`inline-flex w-fit max-w-full items-center gap-0.5 rounded-[6px] bg-surface-default py-0.5 pr-0.5 pl-2.5 ring-1 ring-line-default ${className}`}
    >
      {highlightedHtml ? (
        <code
          class="type-code text-content-primary leading-none [&_.line]:inline [&_.line]:before:content-none [&_.line]:after:content-none"
          set:html={highlightedHtml}
        />
      ) : (
        <code class="type-code text-content-primary leading-none">
          {lines.map((line, lineIndex) => (
            <>
              {line.map((segment) => (
                <span class={segment.className}>{segment.text}</span>
              ))}
              {lineIndex < lines.length - 1 ? <br /> : null}
            </>
          ))}
        </code>
      )}
      <CopyButton
        content={content}
        showText={false}
        className="size-6 shrink-0"
        client:load
      />
    </div>
  ) : (
    <div id={id} class={`${shellClass} ${alignClass} ${className}`}>
      <pre class={preClass}>
        {highlightedHtml ? (
          <code class="[&_.line]:block" set:html={highlightedHtml} />
        ) : (
          <code>
            {lines.map((line, lineIndex) => (
              <>
                {line.map((segment) => (
                  <span class={segment.className}>{segment.text}</span>
                ))}
                {lineIndex < lines.length - 1 ? <br /> : null}
              </>
            ))}
          </code>
        )}
      </pre>
      <div class="flex items-center gap-1">
        <CopyButton
          content={content}
          showText={false}
          className="size-8"
          client:load
        />
      </div>
      <slot />
    </div>
  )
}

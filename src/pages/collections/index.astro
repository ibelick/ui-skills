---
export const prerender = true;

import { collections } from "../../data/collections.ts";
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../ui/breadcrumbs.astro";
import CollectionCard from "../../ui/collection-card.astro";

const breadcrumbItems = [
  { label: "Home", href: "/" },
  { label: "Collections" },
];
const siteOrigin = Astro.site ?? new URL("https://www.ui-skills.com");
const pageUrl = new URL("/collections", siteOrigin).toString();
const structuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "UI Design Collections",
  description:
    "Intent-led UI Skills collections for common design and frontend problems.",
  url: pageUrl,
  hasPart: {
    "@type": "ItemList",
    itemListElement: collections.map((collection, index) => ({
      "@type": "ListItem",
      position: index + 1,
      url: new URL(`/collections/${collection.slug}`, siteOrigin).toString(),
      name: collection.title,
    })),
  },
};
---

<Layout
  structuredData={structuredData}
  title="UI Design Collections | UI Skills"
  description="Explore UI Skills collections for common design problems, from mobile app design and website layout to forms, navigation, and design systems."
>
  <div class="relative flex min-h-dvh flex-col items-center px-0 sm:px-4">
    <div class="relative mt-20 w-full max-w-3xl sm:px-0">
      <div class="mx-auto flex w-full flex-col gap-8">
        <Breadcrumbs items={breadcrumbItems} />

        <div class="px-4 sm:px-0">
          <h1
            class="text-parchment-900 text-3xl font-medium tracking-tight text-balance"
          >
            Collections
          </h1>
          <p
            class="text-parchment-600 mt-3 max-w-2xl text-base leading-snug text-pretty"
          >
            Collections group UI skills by the problem you are solving. Choose
            the collection that matches your work, then explore the recommended
            skills and Playbook examples for that task.
          </p>
        </div>

        <div class="grid gap-4 px-4 sm:grid-cols-2 sm:px-0">
          {
            collections.map((collection) => (
              <CollectionCard
                href={`/collections/${collection.slug}`}
                title={collection.title}
                description={collection.cardDescription}
              />
            ))
          }
        </div>
      </div>
    </div>
  </div>
</Layout>

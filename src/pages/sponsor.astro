---
export const prerender = true;

import {
  CurrencyDollarIcon,
  EyeIcon,
  Square2StackIcon,
  UsersIcon,
} from "@heroicons/react/24/outline";
import Layout from "../layouts/Layout.astro";

const siteOrigin = Astro.site ?? new URL("https://www.ui-skills.com");
const pageUrl = new URL("/sponsor", siteOrigin).toString();
const pageTitle = "Sponsor | UI Skills";
const pageDescription =
  "Sponsor UI Skills. A corner card on the site and a place in the GitHub README. $3k for 30 days.";
const mailto = "mailto:hello@interfaceoffice.com?subject=Sponsor%20UI%20Skills";
const contactEmail = "hello@interfaceoffice.com";

const stats = [
  { label: "Page views", value: "240k+", context: "On the site", icon: EyeIcon },
  { label: "Unique visitors", value: "88k+", context: "On the site", icon: UsersIcon },
  { label: "Clones", value: "60k+", context: "README · 14 days", icon: Square2StackIcon },
  { label: "30 days", value: "$3k", context: "Site and README", icon: CurrencyDollarIcon },
];

const questions = [
  {
    question: "What is included?",
    answer:
      "On the site, the card in the corner of every page: your logo, product name, one line, and a link. In the GitHub README, a row under the image: your logo, product name, and one line. There is no separate header or sidebar placement on the site.",
  },
  {
    question: "How many sponsors run at once?",
    answer:
      "Three at most. The partner card stays in the corner on every visit.",
  },
  {
    question: "Are clicks guaranteed?",
    answer:
      "No. Clicks depend on the product and the line of copy. We measure clicks on the card and share that count. We do not promise a number.",
  },
  {
    question: "How long does a sponsorship run?",
    answer:
      "We agree the dates by email before the card changes. Tell us the month you want to start.",
  },
  {
    question: "Can I change the card?",
    answer: "Yes. Send a new line, logo, or link and we update the card.",
  },
  {
    question: "How do I book?",
    answer: `Email ${contactEmail} with your product name, a square logo, the URL, and one sentence about what it does.`,
  },
];

const previewSkills = [
  {
    slug: "ui-skills-root",
    owner: "ibelick",
    description: "Route an agent to the smallest useful UI skill.",
  },
  {
    slug: "improve-ui",
    owner: "ibelick",
    description: "Audit a surface and write a plan for another agent.",
  },
  {
    slug: "frontend-design",
    owner: "anthropics",
    description: "Build a distinctive, production-grade interface.",
  },
];

const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: pageTitle,
  description: pageDescription,
  url: pageUrl,
};
---

<Layout
  structuredData={structuredData}
  title={pageTitle}
  description={pageDescription}
  showNewsletter={false}
>
  <div class="relative flex min-h-dvh flex-col items-center justify-start">
    <article class="container-3xl relative mt-20 flex flex-col gap-16 pb-8 sm:gap-24">
      <header class="flex w-full flex-col gap-10">
        <div class="flex max-w-xl flex-col gap-3">
          <h1 class="type-h1 text-content-primary text-balance">
            Reach design engineers while they are building
          </h1>
          <p class="text-content-secondary text-base text-pretty">
            Sponsor UI Skills. A corner card on the site and a place in the GitHub README.
          </p>
        </div>
        <dl class="bg-line-default ring-line-default grid w-full grid-cols-2 gap-px overflow-hidden rounded-lg ring-1 sm:grid-cols-4">
          {
            stats.map((item) => {
              const Icon = item.icon;
              return (
                <div class="bg-surface-default min-w-0 px-4 py-5">
                  <Icon className="text-content-secondary size-6" aria-hidden="true" />
                  <dt class="type-body-sm text-content-secondary mt-3">{item.context}</dt>
                  <dd class="text-content-primary mt-2 text-2xl font-[450] tabular-nums">{item.value}</dd>
                  <p class="type-body-sm text-content-secondary mt-1">{item.label}</p>
                </div>
              );
            })
          }
        </dl>
      </header>

      <section class="grid gap-16 sm:grid-cols-2 sm:gap-8">
        <div class="flex min-w-0 flex-col gap-5">
        <h2 id="placement-heading" class="type-h2 text-content-primary text-balance">
          One card, on every page
        </h2>
        <figure>
          <div class="@container ring-line-default relative aspect-video w-full select-none overflow-hidden rounded-lg ring-1">
            <div
              class="pointer-events-none absolute top-0 left-0 h-[360px] w-[640px] origin-top-left [transform:scale(calc(100cqw/640px))]"
              aria-hidden="true"
            >
              <div class="relative h-full w-full">
                <div class="flex h-full items-center justify-center">
                <div class="flex w-full max-w-lg flex-col gap-2 px-4">
                  <div class="text-content-primary flex items-center gap-2">
                    <img src="/uiskills-logo-light.webp" alt="" width="16" height="16" class="size-4" />
                    <span class="text-sm font-[450]">UI Skills</span>
                  </div>
                  <p class="text-content-primary text-lg leading-tight">
                    Curated skills for design engineering
                  </p>
                  <div class="grid grid-cols-2 gap-2">
                    <div class="ring-line-default rounded-md p-2 ring-1">
                      <div class="text-content-primary text-sm font-[450]">CLI</div>
                      <div class="text-content-secondary mt-0.5 text-xs">
                        Run the UI Skills CLI from your terminal.
                      </div>
                    </div>
                    <div class="ring-line-default rounded-md p-2 ring-1">
                      <div class="text-content-primary text-sm font-[450]">MCP</div>
                      <div class="text-content-secondary mt-0.5 text-xs">
                        Connect your agent to the UI Skills catalog.
                      </div>
                    </div>
                  </div>
                  <div class="flex flex-col">
                    <div class="text-content-secondary text-sm font-[450]">Skills</div>
                    {
                      previewSkills.map((skill) => (
                        <div class="border-line-default flex items-center gap-2 border-b py-1.5">
                          <img
                            src={`https://github.com/${skill.owner}.png?size=64`}
                            alt=""
                            width="28"
                            height="28"
                            class="border-line-default size-7 shrink-0 rounded-lg border"
                          />
                          <span class="min-w-0">
                            <span class="flex items-center gap-1.5">
                              <span class="text-content-primary truncate text-sm font-[450]">{skill.slug}</span>
                              <span class="text-content-muted shrink-0 text-xs">{skill.owner}</span>
                            </span>
                            <span class="text-content-secondary block truncate text-xs">{skill.description}</span>
                          </span>
                        </div>
                      ))
                    }
                  </div>
                </div>
                </div>
                <div class="bg-surface-default/60 absolute inset-0"></div>
                <div class="gold-card absolute right-4 bottom-4 h-16 w-40 rounded-lg shadow-xs"></div>
              </div>
            </div>
          </div>
        </figure>
        </div>
        <div class="flex min-w-0 flex-col gap-5">
          <h2 class="type-h2 text-content-primary text-balance">In the README</h2>
          <figure>
            <div class="@container ring-line-default relative aspect-video w-full select-none overflow-hidden rounded-lg ring-1">
              <div
                class="pointer-events-none absolute top-0 left-0 h-[360px] w-[640px] origin-top-left [transform:scale(calc(100cqw/640px))]"
                aria-hidden="true"
              >
                <div class="flex h-full flex-col items-center justify-center gap-2 px-6">
                  <div class="relative w-[22rem]">
                    <p class="text-content-primary border-line-default border-b pb-2 text-center text-lg font-[450]">UI Skills</p>
                    <img
                      src="/UI-OG.png"
                      alt=""
                      width="1200"
                      height="630"
                      class="mt-2 h-auto w-full rounded-md"
                    />
                    <div class="bg-surface-default/60 absolute inset-0"></div>
                  </div>
                  <div class="flex flex-col items-center gap-1.5">
                    <p class="text-content-secondary text-xs font-[450]">Sponsors</p>
                    <div class="gold-card relative h-8 w-56 rounded-md"></div>
                  </div>
                  <div class="relative w-[22rem] text-center">
                    <p class="text-content-primary text-sm">Skills for Design Engineers.</p>
                    <p class="text-content-secondary mt-1 text-sm">More on ui-skills.com</p>
                    <div class="bg-surface-default/60 absolute inset-0"></div>
                  </div>
                </div>
              </div>
            </div>
          </figure>
        </div>
      </section>

      <section class="flex max-w-xl flex-col gap-8">
        {
          questions.map((item) => (
            <div class="flex flex-col gap-2">
              <h2 class="type-body-md text-content-primary font-[450]">{item.question}</h2>
              <p class="type-body-md text-content-secondary text-pretty">
                {item.answer.includes(contactEmail) ? (
                  <>
                    {item.answer.split(contactEmail)[0]}
                    <a
                      href={mailto}
                      class="text-content-primary focus-visible:outline-content-primary underline underline-offset-4 focus-visible:outline-1 focus-visible:outline-offset-2"
                      data-s-event="sponsor_inquiry"
                    >
                      {contactEmail}
                    </a>
                    {item.answer.split(contactEmail)[1]}
                  </>
                ) : (
                  item.answer
                )}
              </p>
            </div>
          ))
        }
      </section>
    </article>
  </div>
</Layout>

<style>
  .gold-card {
    overflow: hidden;
    background-image: linear-gradient(100deg, #8f9296, #c9ccd0 45%, #e4e6e9 60%, #a6a9ad);
  }

  .gold-card::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.6),
      inset 0 -1px 0 rgba(30, 32, 36, 0.3);
    pointer-events: none;
  }
</style>

<script>
  const fragment = `precision mediump float;
uniform vec2 r;uniform float s,d;
float h(vec2 p){return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5453);}
float n(vec2 p){vec2 i=floor(p),f=fract(p);f*=f*(3.-2.*f);return mix(mix(h(i),h(i+vec2(1,0)),f.x),mix(h(i+vec2(0,1)),h(i+1.),f.x),f.y);}
void main(){
vec2 g=gl_FragCoord.xy/d,u=gl_FragCoord.xy/r;
float l=h(vec2(floor(g.y*2.),7.));
float b=n(vec2(g.x*.04,g.y*2.))*.4+n(vec2(g.x*.01,g.y*.7))*.35+l*.25;
float q=u.x-.2*u.y+s*.25;
float k=.32*exp(-pow((q-.55)*6.,2.))+.1*exp(-pow((q-.15)*3.,2.));
float e=.6+(b-.5)*.08+k*(.4+b)+.05*(u.y-.5);
e*=1.-.1*pow(abs(u.x*2.-1.),6.);
vec3 c=e*vec3(.962,.972,.99)+(h(gl_FragCoord.xy)-.5)*.012;
gl_FragColor=vec4(c,1);}`;

  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

  for (const card of document.querySelectorAll<HTMLElement>(".gold-card")) {
    const canvas = document.createElement("canvas");
    canvas.style.cssText = "position:absolute;inset:0;width:100%;height:100%";
    const gl = canvas.getContext("webgl", { antialias: false });
    if (!gl) continue;

    const program = gl.createProgram()!;
    for (const [type, source] of [
      [gl.VERTEX_SHADER, "attribute vec2 a;void main(){gl_Position=vec4(a,0,1);}"],
      [gl.FRAGMENT_SHADER, fragment],
    ] as const) {
      const shader = gl.createShader(type)!;
      gl.shaderSource(shader, source);
      gl.compileShader(shader);
      gl.attachShader(program, shader);
    }
    gl.linkProgram(program);
    if (!gl.getProgramParameter(program, gl.LINK_STATUS)) continue;
    gl.useProgram(program);
    gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    gl.enableVertexAttribArray(0);
    gl.vertexAttribPointer(0, 2, gl.FLOAT, false, 0, 0);
    const resolution = gl.getUniformLocation(program, "r");
    const scroll = gl.getUniformLocation(program, "s");
    const density = gl.getUniformLocation(program, "d");
    card.append(canvas);

    let current = -1;
    let frame = 0;
    let visible = false;

    const draw = () => {
      frame = 0;
      const rect = canvas.getBoundingClientRect();
      const dpr = Math.min(devicePixelRatio, 2);
      const width = Math.round(rect.width * dpr);
      const height = Math.round(rect.height * dpr);
      if (canvas.width !== width || canvas.height !== height) {
        canvas.width = width;
        canvas.height = height;
        gl.viewport(0, 0, width, height);
        gl.uniform2f(resolution, width, height);
        gl.uniform1f(density, dpr);
      }
      const target = reduce
        ? 0.5
        : Math.min(Math.max(1 - (rect.top + rect.height / 2) / innerHeight, 0), 1);
      current = current < 0 ? target : current + (target - current) * 0.08;
      gl.uniform1f(scroll, current);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
      if (visible && Math.abs(target - current) > 0.0005) schedule();
    };

    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(draw);
    };

    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (visible) schedule();
    }).observe(card);

    addEventListener("resize", schedule, { passive: true });
    if (!reduce) addEventListener("scroll", () => visible && schedule(), { passive: true });
  }
</script>
